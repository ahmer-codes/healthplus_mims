# HealthPlus Medicine Inventory
# Copy to .env.local and fill in values from Firebase Console → Project settings → Your apps.
# Never commit real secrets or service-account private keys.

# —— Firebase web app (client) ——
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# —— Authorized admin email (must match a Firebase Auth Email/Password user) ——
# Sign in to the app with this email and the password set in Firebase Console.
# Example: staff@hospital.com / hospital
VITE_DEMO_AUTH_EMAIL=staff@hospital.com
